{
  "name": "codex-modeling-center-bridge",
  "version": "0.1.6",
  "description": "Cross-platform desktop bridge for a private CAD modeling center",
  "license": "MIT",
  "type": "module",
  "bin": {
    "codex-modeling-bridge": "./src/cli.mjs"
  },
  "main": "desktop/main.mjs",
  "scripts": {
    "check": "node --check src/cli.mjs && node --check src/runner.mjs && node --check src/codex-session.mjs && node --check src/claude-session.mjs && node --check src/agent-session.mjs && node --check src/agent-identity.mjs && node --check src/heartbeat.mjs && node --check src/usage.mjs && node --check src/task-control.mjs && node --check src/site-client.mjs && node --check src/desktop-runtime.mjs && node --check desktop/main.mjs && node --check desktop/renderer.mjs",
    "test": "node --test",
    "doctor": "node src/cli.mjs doctor",
    "start": "node src/cli.mjs start",
    "desktop:dev": "electron .",
    "desktop:pack": "electron-builder --dir --publish never",
    "desktop:dist": "electron-builder --publish never"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@openai/codex-sdk": "0.147.0"
  },
  "devDependencies": {
    "electron": "43.4.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.lagrangebandits.codex-modeling-center-bridge",
    "productName": "Modeling Center Bridge",
    "asar": true,
    "asarUnpack": [
      "src/**",
      "templates/**",
      "node_modules/**"
    ],
    "files": [
      "desktop/**/*",
      "src/**/*",
      "templates/**/*",
      "package.json",
      "package-lock.json",
      "!desktop/index 2.html",
      "!desktop/main 2.mjs",
      "!desktop/preload 2.cjs",
      "!desktop/renderer 2.mjs",
      "!desktop/styles 2.css",
      "!src/agent-session 2.mjs",
      "!src/claude-session 2.mjs",
      "!src/desktop-runtime 2.mjs"
    ],
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
